{
  "name": "winston-notebook",
  "version": "1.0.0",
  "description": "A personal notebook powered by Markdown and GitHub Discussions.",
  "scripts": {
    "dev": "npm run sync && npm run prepare:pdf-assets && astro dev --host 127.0.0.1",
    "build": "npm run sync && npm run prepare:pdf-assets && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "sync": "node scripts/sync-discussions.mjs",
    "prepare:pdf-assets": "node scripts/prepare-pdf-assets.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^5.18.2",
    "gray-matter": "^4.0.3",
    "katex": "^0.19.1",
    "pdfjs-dist": "^6.5.438",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  }
}
